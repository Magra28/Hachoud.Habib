<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>الأستاذ حشود محمد حبيب – مقرة</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--g:#006233;--g2:#0a8a4a;--r:#d21034;--bg:#f6f8f5;--card:#fff;--tx:#14221b;--mut:#5a6b61;--bd:#dde6df;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1612;--card:#16221b;--tx:#eef4ef;--mut:#a3b4a9;--bd:#26372d}}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--tx);font-family:'Cairo',Tahoma,Arial,sans-serif;line-height:1.8}
.hero{background:linear-gradient(135deg,#004d28,var(--g) 55%,var(--g2));color:#fff;text-align:center;padding:56px 20px 72px;position:relative;overflow:hidden}
.hero:after{content:"";position:absolute;inset:auto 0 0 0;height:8px;background:linear-gradient(90deg,var(--g) 33%,#fff 33% 66%,var(--r) 66%)}
.badge{display:inline-flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:18px}
.badge span{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.4);border-radius:30px;padding:2px 16px;font-weight:600;font-size:.95rem}
.badge b{color:#ffd9df}
h1{font-size:clamp(1.9rem,6vw,3.4rem);margin:6px 0;font-weight:800;line-height:1.35}
.sub{opacity:.92;font-size:1.1rem;margin:0 auto;max-width:640px}
.slogan{display:inline-block;margin-top:26px;background:#fff;color:var(--r);font-weight:800;font-size:clamp(1.1rem,4vw,1.6rem);padding:10px 26px;border-radius:14px;box-shadow:0 8px 24px rgba(0,0,0,.25)}
.btns{margin-top:26px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn{display:inline-block;padding:11px 28px;border-radius:12px;font:inherit;font-weight:700;text-decoration:none;border:2px solid #fff;color:#fff;cursor:pointer;background:transparent}
.btn.p{background:var(--r);border-color:var(--r)}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--card);border-bottom:1px solid var(--bd);display:flex;gap:6px;justify-content:center;padding:8px;flex-wrap:wrap}
nav a{color:var(--g);text-decoration:none;font-weight:600;padding:4px 14px;border-radius:8px}
nav a:hover{background:var(--bd)}
@media (prefers-color-scheme:dark){nav a{color:#7fd6a4}}
section{max-width:1100px;margin:0 auto;padding:48px 18px}
h2{font-size:1.8rem;margin:0 0 6px;color:var(--g);text-align:center}
@media (prefers-color-scheme:dark){h2{color:#7fd6a4}}
.bar{width:90px;height:5px;margin:0 auto 28px;border-radius:5px;background:linear-gradient(90deg,var(--g) 33%,var(--bd) 33% 66%,var(--r) 66%)}
.about{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:26px;text-align:center;font-size:1.1rem}
.nums{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:18px}
.nums div{background:var(--g);color:#fff;border-radius:14px;padding:10px 26px;font-weight:700}
.nums div:nth-child(2){background:var(--r)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:18px}
.card{background:var(--card);border:1px solid var(--bd);border-top:5px solid var(--g);border-radius:16px;padding:20px;transition:transform .2s}
.card:nth-child(3n){border-top-color:var(--r)}
.card:hover{transform:translateY(-4px)}
.card h3{margin:0 0 10px;font-size:1.12rem;display:flex;gap:10px;align-items:center}
.card h3 i{font-style:normal;background:var(--g);color:#fff;border-radius:50%;min-width:34px;height:34px;display:grid;place-items:center;font-size:.95rem}
.card:nth-child(3n) h3 i{background:var(--r)}
.card ul{margin:0;padding:0 18px 0 0;color:var(--mut);font-size:.97rem}
.card li{margin-bottom:4px}
.band{background:linear-gradient(135deg,var(--g),#004d28);color:#fff;text-align:center;padding:34px 18px;font-size:1.3rem;font-weight:700}
form{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:24px;max-width:640px;margin:0 auto;display:grid;gap:12px}
label{font-weight:600;font-size:.95rem}
input,select,textarea{width:100%;padding:11px 14px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);font:inherit}
textarea{min-height:130px;resize:vertical}
form .btn{background:var(--g);border-color:var(--g);font-size:1.05rem}
.note{text-align:center;color:var(--mut);font-size:.9rem;margin:0}
footer{background:#10231a;color:#d7e4dc;text-align:center;padding:28px 18px;border-top:8px solid var(--r)}
footer b{color:#fff}

.progress{position:fixed;top:0;inset-inline:0;height:4px;z-index:50;transform-origin:right;transform:scaleX(0);background:linear-gradient(90deg,#006233,#fff,#d21034)}
.hero{background:linear-gradient(120deg,#003d20,#006233,#0a8a4a,#006233);background-size:300% 300%;animation:bg 16s ease infinite;text-align:start}
@keyframes bg{50%{background-position:100% 50%}}
.blob{position:absolute;border-radius:50%;filter:blur(60px);opacity:.35;animation:fl 9s ease-in-out infinite}
.b1{width:300px;height:300px;background:#d21034;top:-80px;left:-60px}.b2{width:260px;height:260px;background:#fff;bottom:-90px;right:10%;animation-delay:-4s}
@keyframes fl{50%{transform:translate(40px,30px) scale(1.15)}}
.hwrap{position:relative;display:grid;grid-template-columns:1.25fr 1fr;gap:34px;align-items:center;max-width:1100px;margin:0 auto}
.htxt .badge,.htxt .btns{justify-content:flex-start}.htxt .sub{margin:0}
.htxt>*{animation:up .8s both}.htxt>*:nth-child(2){animation-delay:.1s}.htxt>*:nth-child(3){animation-delay:.2s}.htxt>*:nth-child(4){animation-delay:.3s}.htxt>*:nth-child(5){animation-delay:.45s}.htxt>*:nth-child(6){animation-delay:.6s}
@keyframes up{from{opacity:0;transform:translateY(28px)}}
.photo{position:relative;justify-self:center;animation:up 1s .3s both}
.ring{padding:7px;border-radius:26px;background:conic-gradient(var(--r),#fff,var(--g2),var(--r));animation:flo 6s ease-in-out infinite;box-shadow:0 24px 60px rgba(0,0,0,.4)}
.ring img{display:block;width:100%;max-width:380px;border-radius:20px}
@keyframes flo{50%{transform:translateY(-12px) rotate(-1deg)}}
.tag{position:absolute;bottom:-14px;right:-10px;background:var(--r);color:#fff;font-weight:800;padding:6px 20px;border-radius:30px;border:3px solid #fff;font-size:1.2rem;animation:pu 2.4s infinite}
@keyframes pu{50%{transform:scale(1.08)}}
.slogan{background:linear-gradient(100deg,#fff 40%,#ffe3e8 50%,#fff 60%);background-size:250% 100%;animation:sh 3.5s linear infinite}
@keyframes sh{to{background-position:-250% 0}}
.btn{transition:transform .2s,box-shadow .2s}.btn:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(0,0,0,.3)}
nav a.on{background:var(--g);color:#fff}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px}
.stats div{background:var(--card);border:1px solid var(--bd);border-radius:16px;text-align:center;padding:18px}
.stats b{display:block;font-size:2.6rem;color:var(--r);line-height:1.2}.stats span{color:var(--mut);font-weight:600}
.q{display:block;max-width:460px;margin:0 auto 24px;border-radius:30px}
.js .rv{opacity:0;transform:translateY(28px);transition:opacity .6s var(--d,0s),transform .6s var(--d,0s)}.js .rv.in{opacity:1;transform:none}
.card{cursor:default}.card:hover{box-shadow:0 14px 30px rgba(0,98,51,.18)}
.gal{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;align-items:flex-start}
.gal figure{margin:0;flex:1 1 300px;max-width:420px;cursor:zoom-in;overflow:hidden;border-radius:18px;border:5px solid var(--card);box-shadow:0 12px 34px rgba(0,0,0,.18)}
.gal img{display:block;width:100%;transition:transform .5s}.gal figure:hover img{transform:scale(1.05)}
.lb{position:fixed;inset:0;background:rgba(0,0,0,.88);display:none;place-items:center;z-index:60;padding:16px;cursor:zoom-out}.lb.o{display:grid;animation:up .3s}
.lb img{max-width:100%;max-height:100%;border-radius:12px}
.up{position:fixed;bottom:calc(18px + env(safe-area-inset-bottom,0px));left:18px;width:46px;height:46px;border-radius:50%;border:0;background:var(--r);color:#fff;font-size:1.3rem;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s;z-index:40}.up.s{opacity:1;pointer-events:auto}
.ok{text-align:center;padding:30px;font-size:1.3rem;font-weight:700;color:var(--g)}.ok i{display:grid;place-items:center;width:70px;height:70px;margin:0 auto 12px;border-radius:50%;background:var(--g);color:#fff;font-style:normal;font-size:2rem;animation:pu 1.2s 2}
@media(max-width:800px){.hwrap{grid-template-columns:1fr}.photo{order:-1}.ring img{max-width:270px}.htxt{text-align:center}.htxt .badge,.htxt .btns{justify-content:center}.htxt .sub{margin:0 auto}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
</style>
</head>
<body>
<div class="progress" id="pg"></div><header class="hero" id="top"><div class="blob b1"></div><div class="blob b2"></div><div class="hwrap"><div class="htxt">
<div class="badge"><span>حزب جبهة المستقبل · <b>القائمة رقم 03</b></span><span>المترشح <b>رقم 01</b></span></div>
<p class="sub">انتخابات المجلس الشعبي البلدي · بلدية مقرة، ولاية المسيلة</p>
