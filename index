<script>
var S=[
["التهيئة العمرانية والأشغال العمومية","تهيئة الطرقات والأرصفة داخل الأحياء والتجمعات السكنية|فك العزلة عن المناطق الريفية والمداشر|تحسين الإنارة العمومية وتوسيع شبكتها|تهيئة مداخل ومخارج بلدية مقرة وإعطاؤها مظهراً حضارياً|تنظيم مواقف السيارات وحركة المرور|صيانة قنوات صرف مياه الأمطار وتدارك النقائص"],
["البيئة والنظافة والمحيط","تحسين خدمات جمع النفايات المنزلية|القضاء على المفارغ العشوائية والنقاط السوداء|إنشاء مساحات خضراء وحدائق عمومية|إطلاق حملات التشجير والمحافظة على الأشجار|تنظيم حملات تطوعية دورية لنظافة الأحياء|تهيئة فضاءات للراحة والاستجمام العائلي"],
["الشباب والرياضة","إعادة تهيئة الملاعب الجوارية وصيانتها|إنشاء فضاءات رياضية وترفيهية للشباب|دعم الجمعيات والنوادي الرياضية|تنظيم دورات رياضية بين الأحياء والمداشر|استغلال الفضاءات غير المستغلة لإنجاز ملاعب جوارية|تشجيع المواهب الرياضية ومرافقة الطاقات الشابة"],
["التربية والتعليم","متابعة صيانة وترميم المدارس الابتدائية|تحسين التدفئة والإطعام المدرسي والنقل|تهيئة ساحات المدارس ومحيطها الخارجي|توفير فضاءات للمطالعة والأنشطة الثقافية|متابعة احتياجات المؤسسات التربوية بالتنسيق مع الجهات المعنية"],
["الصحة","المطالبة بتدعيم المؤسسات الصحية بالتجهيزات والموارد البشرية|تحسين ظروف استقبال المرضى|دعم حملات التوعية والفحص الصحي|متابعة احتياجات قاعات العلاج بالمناطق الريفية|المطالبة بتطوير الخدمات الصحية وتقريبها من المواطن"],
["التجارة والأسواق","إعادة تنظيم الأسواق التجارية وتهيئة فضاءاتها|تنظيم نشاط الباعة والتجار والقضاء على مظاهر الفوضى|تنظيم اللوحات الإشهارية والواجهات التجارية|تخصيص فضاءات مناسبة للبيع الموسمي|تشجيع النشاط التجاري والحرفي المحلي|تنظيم استغلال الأرصفة والفضاءات العمومية"],
["الثقافة والترفيه","تهيئة المكتبات ودعم المطالعة|تنظيم تظاهرات ثقافية وفنية محلية|المحافظة على التراث والعادات والتقاليد المحلية|إنشاء فضاءات للأنشطة الثقافية|تشجيع المواهب الأدبية والفنية لدى الأطفال والشباب"],
["الاستثمار والتنمية الاقتصادية","تشجيع الاستثمار المحلي وتهيئة مناطق للنشاط الاقتصادي|مرافقة الشباب حاملي المشاريع|تثمين المؤهلات الفلاحية والتجارية للبلدية|تشجيع الصناعات والحرف التقليدية|العمل على استقطاب مشاريع اقتصادية توفر مناصب شغل"],
["السكن والتحسين الحضري","متابعة انشغالات المواطنين المتعلقة بالسكن|تحسين المحيط العمراني للأحياء السكنية|معالجة النقائص المتعلقة بالتهيئة الحضرية|القضاء على البناءات الفوضوية وفق القوانين المعمول بها|استغلال العقار المتاح لإنجاز مرافق عمومية ومساحات خضراء"],
["الخدمات العمومية والحوكمة المحلية","تحسين استقبال المواطنين والتكفل بانشغالاتهم|تبسيط الإجراءات الإدارية في حدود صلاحيات البلدية|اعتماد الشفافية في تسيير المشاريع والميزانية|إشراك المواطنين والجمعيات في تحديد الأولويات|نشر حصيلة دورية حول المشاريع المنجزة والمبرمجة|اعتماد مبدأ العدالة في توزيع المشاريع بين مختلف الأحياء والمداشر"],
["الفلاحة والموارد المائية","دعم الفلاحين ومرافقتهم بالتنسيق مع المصالح المختصة|المطالبة بتحسين التزود بالمياه الصالحة للشرب|متابعة وضعية شبكات المياه والتطهير|تشجيع التشجير المثمر والمحافظة على الأراضي الفلاحية|دعم المبادرات الرامية إلى تثمين المنتوجات الفلاحية المحلية"],
["الطفولة والمرأة والأسرة","إنشاء فضاءات لعب آمنة للأطفال|دعم الأنشطة التربوية والترفيهية|تشجيع المبادرات النسوية والجمعوية|تنظيم نشاطات توعوية واجتماعية لفائدة الأسرة|الاهتمام بالأشخاص ذوي الاحتياجات الخاصة وتسهيل وصولهم إلى المرافق العمومية"]
];
document.getElementById('grid').innerHTML=S.map(function(s,i){
return '<div class="card"><h3><i>'+(i+1)+'</i>'+s[0]+'</h3><ul>'+s[1].split('|').map(function(x){return '<li>'+x+'</li>'}).join('')+'</ul></div>'}).join('');
document.documentElement.classList.add('js');
var $=function(i){return document.getElementById(i)};
$('cn').dataset.n=S.reduce(function(a,s){return a+s[1].split('|').length},0);
var cards=[].slice.call(document.querySelectorAll('.card'));
cards.forEach(function(c,i){c.classList.add('rv');c.style.setProperty('--d',(i%3)*.1+'s')});
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;t.classList.add('in');io.unobserve(t);var b=t.querySelector&&t.querySelector('b[data-n]');if(b)cnt(b)})},{threshold:.15});
document.querySelectorAll('.rv').forEach(function(x){io.observe(x)});
function cnt(b){var n=+b.dataset.n,t0=performance.now();(function f(t){var p=Math.min((t-t0)/1400,1);b.textContent=Math.round(n*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(f)})(t0)}
$('q').addEventListener('input',function(){var v=this.value.trim(),k=0;cards.forEach(function(c){var m=!v||c.textContent.indexOf(v)>-1;c.style.display=m?'':'none';if(m)k++});$('em').hidden=k>0});
var secs=['top','about','program','gallery','contact'].map($),links=[].slice.call(document.querySelectorAll('nav a'));
addEventListener('scroll',function(){var h=document.documentElement,y=scrollY;$('pg').style.transform='scaleX('+y/(h.scrollHeight-innerHeight)+')';$('up').classList.toggle('s',y>600);var cur='';secs.forEach(function(s){if(s&&s.offsetTop-120<=y)cur=s.id});links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')=='#'+cur)})},{passive:true});
$('up').onclick=function(){scrollTo({top:0,behavior:'smooth'})};
